{
  "name": "deskpass",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Deskpass: a Windows computer use MCP server",
  "bin": {
    "deskpass": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:helper": "cargo build --release --manifest-path helper/Cargo.toml",
    "build": "npm run build:helper && npm run build:ts && node scripts/copy-helper.mjs",
    "test": "node --experimental-strip-types --import ./test/isolate-localappdata.mjs --test \"test/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path helper/Cargo.toml",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.25.12",
    "typescript": "^5.9.0"
  }
}
